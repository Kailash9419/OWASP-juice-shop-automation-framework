<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Juice Shop - Full Regression" parallel="classes" thread-count="2">
    <listeners>
        <listener class-name="Utility.Listeners" />
        <listener class-name="Utility.AnnotationTransformer" />
    </listeners>

    <test name="End to End Regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="tests.End2End_2" />
        </classes>
    </test>
</suite>